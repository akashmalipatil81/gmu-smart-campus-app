# Set a real administrator Aadhaar only in your local environment.
# The app performs format + Verhoeff checksum validation; it does not call UIDAI.
APP_ADMIN_AADHAAR=
APP_ADMIN_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret-value-at-least-32-characters
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/gmu_smart_campus
